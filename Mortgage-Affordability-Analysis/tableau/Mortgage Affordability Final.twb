          <zone h='6552' id='17' mode='dropdown' name='County median burden change | Contiguous U.S.' param='[federated.0dgypka0lcwoy41ckwlhk1q395w4].[none:state:nk]' type-v2='filter' values='cascading' w='20919' x='79081' y='55645'>
