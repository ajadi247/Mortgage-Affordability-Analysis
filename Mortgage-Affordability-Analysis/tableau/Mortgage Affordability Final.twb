          <zone forceUpdate='true' h='7560' id='5' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontcolor='#17324d' fontname='Segoe UI' fontsize='22'>US Mortgage Affordability | 2015–2024</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontname='Segoe UI' fontsize='10'>How home values, household income, and mortgage rates changed the cost of financing a typical-valued home across 2,486 U.S. counties.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='12' />
